diff -ru orig/drm_gpuvm.c new/drm_gpuvm.c
--- a/drm_gpuvm.c	2026-11-27 10:13:09.286926367 +0000
+++ b/drm_gpuvm.c	2026-11-27 10:45:04.325560865 +0000
@@ -1147,6 +1147,13 @@
 
 	drm_gpuvm_resv_assert_held(gpuvm);
 	list_for_each_entry(vm_bo, &gpuvm->extobj.list, list.entry.extobj) {
+		/* HMI debug: an object being freed must not be in the list. */
+		if (!kref_read(&vm_bo->obj->refcount)) {
+			pr_err("panthor-debug: extobj vm_bo %p obj %p (size %zu, imported %d) has refcount 0 in %s, skipped\n",
+			       vm_bo, vm_bo->obj, vm_bo->obj->size, drm_gem_is_imported(vm_bo->obj), gpuvm->name);
+			dump_stack();
+			continue;
+		}
 		ret = exec_prepare_obj(exec, vm_bo->obj, num_fences);
 		if (ret)
 			break;
@@ -1507,6 +1514,19 @@
 
 	if (!lock)
 		drm_gpuvm_resv_assert_held(gpuvm);
+	/* HMI debug: the lists are protected by the VM resv (no lockdep here). */
+	if (!lock && !dma_resv_is_locked(drm_gpuvm_resv(gpuvm))) {
+		static atomic_t hmi_reports = ATOMIC_INIT(0);
+		struct dma_resv *r = drm_gpuvm_resv(gpuvm);
+
+		if (atomic_inc_return(&hmi_reports) <= 5) {
+			pr_err("panthor-debug: vm_bo %p destroyed without the VM resv held (%s): gpuvm %px r_obj %px resv %px owner %lx current %px sizeof(gem) %zu off(resv) %zu\n",
+			       vm_bo, gpuvm->name, gpuvm, gpuvm->r_obj, r,
+			       (unsigned long)atomic_long_read(&r->lock.base.owner), current,
+			       sizeof(struct drm_gem_object), offsetof(struct drm_gem_object, resv));
+			dump_stack();
+		}
+	}
 
 	drm_gpuvm_bo_list_del(vm_bo, extobj, lock);
 	drm_gpuvm_bo_list_del(vm_bo, evict, lock);
@@ -1675,6 +1695,10 @@
 
 	if (!lock)
 		drm_gpuvm_resv_assert_held(gpuvm);
+	if (!lock && !dma_resv_is_locked(drm_gpuvm_resv(gpuvm))) {
+		pr_err("panthor-debug: extobj add of vm_bo %p without the VM resv held (%s)\n", vm_bo, gpuvm->name);
+		dump_stack();
+	}
 
 	if (drm_gpuvm_is_extobj(gpuvm, vm_bo->obj))
 		drm_gpuvm_bo_list_add(vm_bo, extobj, lock);
@@ -2748,5 +2772,6 @@
 }
 EXPORT_SYMBOL_GPL(drm_gpuva_ops_free);
 
+MODULE_INFO(hmi_debug, "3");
 MODULE_DESCRIPTION("DRM GPUVM");
 MODULE_LICENSE("GPL");
